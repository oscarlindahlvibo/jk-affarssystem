VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sätt till production vid deploy till projekt.jkprojekt.se.
# Då kräver appen Supabase och testinloggning/mockanvändare döljs.
VITE_APP_ENV=development
VITE_REQUIRE_SUPABASE=false
VITE_ALLOW_MOCK_AUTH=true

# Google Drive (dokumentlagring) – se README för steg-för-steg-guide för att skapa
# ett Google Cloud-projekt och en OAuth-klient.
VITE_GOOGLE_CLIENT_ID=

# Central server-side storage in a Google Shared Drive.
VITE_CENTRAL_DRIVE_ENABLED=false
